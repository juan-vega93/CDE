{
  "name": "cde-portal",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/bff"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:bff": "npm run dev -w bff",
    "lint": "npm run lint -w bff && npm run lint -w frontend",
    "typecheck": "npm run typecheck -w bff && npm run typecheck -w frontend",
    "build": "npm run build -w bff && npm run build -w frontend",
    "test": "npm test -w bff",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "npm run db:migrate -w bff",
    "db:backfill": "npm run db:backfill -w bff",
    "db:check": "npm run db:check -w bff"
  },
  "dependencies": {
    "@thatopen/components": "^3.4.0",
    "@thatopen/components-front": "^3.4.0",
    "@thatopen/fragments": "^3.4.1",
    "@thatopen/ui": "^3.4.0",
    "@thatopen/ui-obc": "^3.4.0",
    "multer": "^2.1.1",
    "three": "^0.183.2",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
